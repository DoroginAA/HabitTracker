<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трекер привычек" Height="750" Width="1100" 
        WindowStartupLocation="CenterScreen" Background="#f4f5f7"
        MinHeight="500" MinWidth="1000">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для выпадающих списков -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню -->
        <Border x:Name="LeftSidebar" Grid.Column="0" Background="White" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30" HorizontalAlignment="Center">
                    <Button Click="BtnProfile_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Grid>
                            <Ellipse Width="80" Height="80" Fill="#0078D7"/>
                            <Image x:Name="ImgAvatar" Width="80" Height="80" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="TxtUsername" Text="Пользователь" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="📋 Мои привычки" Style="{StaticResource MenuButton}" Click="MenuHabits_Click"/>
                    <Button Content="📊 Статистика" Style="{StaticResource MenuButton}" Click="MenuStats_Click"/>
                    <Button Content="🗄️ Архив" Style="{StaticResource MenuButton}" Click="MenuArchive_Click"/>
                    <Button Content="⚙️ Настройки" Style="{StaticResource MenuButton}" Click="MenuSettings_Click"/>
                    <Button Content="ℹ️ О программе" Style="{StaticResource MenuButton}" Click="MenuAbout_Click"/>
                </StackPanel>

                <Button Grid.Row="2" Content="🚪 Выйти" Style="{StaticResource MenuButton}" Foreground="#dc3545" Click="BtnLogout_Click" Margin="0,20,0,0"/>
            </Grid>
        </Border>

        <!-- Основной контент -->
        <TabControl x:Name="MainTabControl" Grid.Column="1" Background="Transparent" BorderThickness="0" Margin="20">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Visibility="Collapsed" />
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!-- Вкладка привычки -->
            <TabItem Header="Привычки">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель управления -->
                    <Border x:Name="TopControlPanel" Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFilterLabel" Text="Фильтр:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CmbFilter" Width="150" Height="35" SelectionChanged="CmbFilter_SelectionChanged">
                                    <ComboBoxItem Content="Все" IsSelected="True"/>
                                    <ComboBoxItem Content="Полезные"/>
                                    <ComboBoxItem Content="Вредные"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Grid.Column="2" Content="+ Добавить привычку" Width="180" Height="35" 
                                    Background="#28a745" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                    Click="BtnOpenAddWindow_Click"/>
                        </Grid>
                    </Border>

                    <!-- Список привычек -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="HabitsListPanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка статистика -->
            <TabItem Header="Статистика">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,20">
                            <Border x:Name="StatBorder1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Выполнено сегодня" Foreground="Gray"/>
                                    <TextBlock Text="3 / 5" FontSize="24" FontWeight="Bold" Foreground="#28a745" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatBorder2" Background="White" CornerRadius="8" Padding="20" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Текущая серия" Foreground="Gray"/>
                                    <TextBlock Text="🔥 5 дней" FontSize="24" FontWeight="Bold" Foreground="#dc3545" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatBorder3" Background="White" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Процент выполнения" Foreground="Gray"/>
                                    <TextBlock Text="78%" FontSize="24" FontWeight="Bold" Foreground="#0078D7" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border x:Name="ChartBorder" Background="White" CornerRadius="8" Padding="20" Height="300">
                            <Grid>
                                <TextBlock Text="График активности за неделю" VerticalAlignment="Top" HorizontalAlignment="Left" Foreground="Gray"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="200">
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="100" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Пн" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="150" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Вт" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="80" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Ср" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="190" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Чт" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="200" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Пт" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="120" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Сб" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Width="40" Height="60" Fill="#0078D7" Margin="5,0"/>
                                        <TextBlock Text="Вс" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка настройки -->
            <TabItem Header="Настройки">
                <Border x:Name="SettingsBorder" Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="TxtSettingsTitle" Text="Настройки приложения" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <CheckBox x:Name="ChkReminders" Content="Включить напоминания" IsChecked="True" Margin="0,10"/>
                        <CheckBox x:Name="ChkDarkTheme" Content="Темная тема" Margin="0,10" Click="ChkDarkTheme_Click"/>

                        <TextBlock x:Name="TxtExportTitle" Text="Экспорт данных" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Экспорт в CSV" Padding="15,5" Background="#0078D7" Foreground="White" BorderThickness="0" Click="BtnExport_Click" Tag="CSV"/>
                            <Button Content="Экспорт в PDF" Padding="15,5" Margin="10,0,0,0" Background="#0078D7" Foreground="White" BorderThickness="0" Click="BtnExport_Click" Tag="PDF"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Вкладка архив -->
            <TabItem Header="Архив">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" x:Name="ArchiveHeader">
                        <TextBlock x:Name="TxtArchiveHeader" Text="Архив привычек (неактивные)" FontSize="18" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ArchivedListPanel"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Вкладка о программе -->
            <TabItem Header="О программе">
                <Border x:Name="AboutBorder" Background="White" CornerRadius="8" Padding="20">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtAboutTitle" Text="Курсовой проект" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtAboutDesc" Text="Тема: Разработка приложения для учёта и анализа личных привычек" FontSize="16" Margin="0,10" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
                        <TextBlock x:Name="TxtAboutAuthor" Text="Выполнил: Дорогин" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Вкладка профиль -->
            <TabItem Header="Профиль">
                <Border x:Name="ProfileBorder" Background="White" CornerRadius="8" Padding="30">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProfileHeader" Text="Профиль пользователя" FontSize="24" FontWeight="Bold" Margin="0,0,0,30"/>

                        <Grid Width="100" Height="100" Margin="0,0,0,20">
                            <Ellipse Fill="#0078D7"/>
                            <Image x:Name="ImgProfileAvatar" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                                </Image.Clip>
                            </Image>
                        </Grid>

                        <TextBlock x:Name="TxtProfileName" Text="Имя пользователя" FontSize="20" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtProfileEmail" Text="Email:" FontSize="14" Foreground="Gray" Margin="0,0,0,30"/>

                        <Button Content="Изменить аватар" Width="200" Height="40" Background="#0078D7" Foreground="White" BorderThickness="0" Click="BtnChangeAvatar_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>