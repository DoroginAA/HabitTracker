<Window x:Class="HabitTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои привычки" Height="500" Width="800"
        Loaded="Window_Loaded" Background="#f4f5f7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления -->
        <Border Grid.Row="0" Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtHabitName" Width="300" Height="35" VerticalContentAlignment="Center" 
                         FontSize="14" Padding="5"/>
                <Button x:Name="BtnAdd" Content="Добавить" Width="120" Height="35" Margin="15,0,0,0" 
                        Click="BtnAdd_Click" Background="#0078D7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Список привычек -->
        <ListBox x:Name="HabitsListBox" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">

            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка привычки -->
                    <Border Background="White" CornerRadius="5" Margin="0,5,0,5" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Текст привычки -->
                            <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#333" 
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Обрезает длинный текст троеточием -->
                                <TextBlock Text="Ежедневно" FontSize="12" Foreground="Gray" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Кнопка удаления -->
                            <Button Grid.Column="1" Content="Удалить" Padding="15,8" 
                                    VerticalAlignment="Center"
                                    Background="#dc3545" Foreground="White" BorderThickness="0"
                                    Click="BtnDelete_Click" Tag="{Binding HabitId}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="3"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>