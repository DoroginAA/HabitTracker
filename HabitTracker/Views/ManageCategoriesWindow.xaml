<Window x:Class="HabitTracker.Views.ManageCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление категориями" Height="400" Width="350" 
        WindowStartupLocation="CenterOwner" Background="#f4f5f7">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="TxtNewCategory" Width="200" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,10,0"/>
            <Button Content="Добавить" Width="100" Height="30" Background="#28a745" Foreground="White" BorderThickness="0" Click="BtnAddCategory_Click"/>
        </StackPanel>

        <ListBox x:Name="LstCategories" Grid.Row="1" Background="White" BorderThickness="0" DisplayMemberPath="."/>
    </Grid>
</Window>